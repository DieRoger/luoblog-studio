# =============================================================================
# LuoBlog Studio — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET=change-me-in-production

# --- Database (PostgreSQL + PGVector) ---
DATABASE_URL=postgresql+asyncpg://luoblog:luoblog@localhost:5432/luoblog
DATABASE_SYNC_URL=postgresql://luoblog:luoblog@localhost:5432/luoblog

# --- LLM Provider ---
# Provider: deepseek | openai
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key

# --- Embedding ---
# Mode: local | api
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL=BAAI/bge-m3
# Only used when EMBEDDING_MODE=api:
EMBEDDING_API_MODEL=text-embedding-3-small

# --- Workspace ---
# Local file storage root
WORKSPACE_ROOT=~/luoblog-workspace

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
